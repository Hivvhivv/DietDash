# Salin menjadi .env.local lalu isi nilainya. Jangan commit .env.local.
# User database sebaiknya hanya punya peran readWrite pada database MONGODB_DB.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=dash-sehat"
MONGODB_DB="dash_sehat"
# Kunci (32 byte, base64) untuk salinan terenkripsi kode akses agar super admin bisa melihat kode responden yang lupa.
# Buat sekali dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Jangan diganti setelah dipakai (kode lama tidak bisa dibuka lagi). Kosong = fitur lihat kode nonaktif.
KUNCI_KODE_AKSES=""
# Untuk pengujian yang menulis data, pakai database terpisah berakhiran _uji (mis. dash_sehat_uji).
